# Development origin. HTTPS is required outside loopback.
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Europe/Paris
ACTIVATION_CODE_TTL=24h
REGISTRATION_VERIFICATION_TTL=1h
EMAIL_CHANGE_TTL=1h

# disabled reports non-delivery; smtp enables the real relay.
EMAIL_TRANSPORT=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=club@example.test
SMTP_STARTTLS=true

# SQLite file; its parent directory is created automatically.
DATABASE_PATH=data/clubcore.db
# This file is a reference: the application reads environment variables,
# and does not automatically load dotenv files.
